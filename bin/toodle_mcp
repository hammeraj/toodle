#!/usr/bin/env bash
# Spawned by an MCP client (Claude Desktop/Code) to talk to Toodle over stdio.
#
# Boots the app WITHOUT the web endpoint (see lib/toodle/application.ex,
# config/runtime.exs) so it can run alongside `mix phx.server` against the
# same SQLite database at once.
set -euo pipefail
cd "$(dirname "$0")/.."

export MIX_ENV="${MIX_ENV:-dev}"
export TOODLE_MCP_ONLY=1

# Compile first, with any build chatter sent to stderr. Once the real server
# is running, nothing but MCP protocol frames may touch stdout, or the
# client's JSON-RPC parser breaks.
mix compile --no-color >&2

exec mix run --no-halt --no-compile
