# The directory Mix will write compiled artifacts to.
/_build/
/_build_windows/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/
/deps_windows/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
toodle-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*

# `mix release` (Desktop.Deployment.generate_installer/1) drops working
# files in the project root while building the installer.
/icon.ico
/app.exe.manifest
/*.nsi
/MicrosoftEdgeWebview2Setup.exe
/vcredist_x64.exe
/Toodle-*.exe
/Toodle-*.dmg

# `mix phx.digest` (part of `mix assets.deploy`) scatters hashed/gzipped
# copies of priv/static's root-level files (favicon, robots.txt, the logo)
# alongside the originals — /priv/static/assets/ above only covers the
# esbuild/tailwind output subdirectory, not these.
/priv/static/favicon-*.ico
/priv/static/robots-*.txt
/priv/static/robots.txt.gz
/priv/static/images/logo-*.svg
/priv/static/images/*.gz

# OS cruft
.DS_Store
Thumbs.db

# Local secrets, should one ever show up here.
.env
.env.*

